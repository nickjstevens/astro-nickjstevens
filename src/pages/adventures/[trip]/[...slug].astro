---
import { getCollection, render } from 'astro:content';
import AdventureLayout from '../../../layouts/AdventureLayout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('adventures');
	return entries
		.filter((entry) => entry.data.kind === 'day')
		.map((entry) => ({
			params: { trip: entry.data.tripSlug, slug: entry.id.split('/').pop() },
			props: { entry },
		}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allDays = (await getCollection('adventures'))
	.filter((item) => item.data.kind === 'day' && item.data.tripSlug === entry.data.tripSlug)
	.sort((a, b) => a.data.order - b.data.order);
const currentIndex = allDays.findIndex((item) => item.id === entry.id);
const previous = currentIndex > 0 ? allDays[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < allDays.length - 1 ? allDays[currentIndex + 1] : null;
const meta = [
	{ label: 'Sleep location', value: entry.data.sleepLocation },
	{ label: 'Morning', value: entry.data.activitiesAm },
	{ label: 'Afternoon', value: entry.data.activitiesPm },
	{ label: 'Evening', value: entry.data.activitiesEvening },
	{ label: 'Driving', value: entry.data.drivingTime },
	{ label: 'Accommodation', value: entry.data.accommodation },
];
---

<AdventureLayout
	title={entry.data.title}
	description={entry.data.description}
	tripTitle={entry.data.tripTitle}
	date={entry.data.date}
	heroImage={entry.data.heroImage}
	meta={meta}
>
	<Content />
	<nav class="day-nav" aria-label="Previous and next adventure days">
		{previous ? <a href={`/adventures/${previous.data.tripSlug}/${previous.id.split('/').pop()}/`}>← {previous.data.title}</a> : <span />}
		<a href={`/adventures/${entry.data.tripSlug}/`}>Trip overview</a>
		{next ? <a href={`/adventures/${next.data.tripSlug}/${next.id.split('/').pop()}/`}>{next.data.title} →</a> : <span />}
	</nav>
</AdventureLayout>

<style>
	.day-nav { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; margin-top: 2.5rem; align-items: center; }
	.day-nav a { padding: 0.75rem 0.9rem; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-alt); color: inherit; text-decoration: none; }
	.day-nav a:last-child { text-align: right; }
	.day-nav a:hover { border-color: var(--accent); color: inherit; text-decoration: none; }
	@media (max-width: 820px) { .day-nav { grid-template-columns: 1fr; } .day-nav a:last-child { text-align: left; } }
</style>
