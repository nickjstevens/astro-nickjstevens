---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import Search from './Search.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<details class="priced-in-dropdown">
				<summary>Priced In</summary>
				<div class="dropdown-menu">
					<a href="/priced-in/">Cost of Living</a>
					<a href="/priced-in/single.html?item=house&denom=context:fiat">Single Series</a>
					<a href="/priced-in/macro.html">Macro Trends</a>
					<a href="/priced-in/assumptions.html">About</a>
				</div>
			</details>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/blog/tags">Tags</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/now">Now</HeaderLink>
		</div>
		<div class="search-wrapper">
			<Search />
		</div>
		<div class="social-links">
			<a href="https://x.com/nick_j_stevens" target="_blank">
				<span class="sr-only">Follow me on X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
					></path></svg
				>
			</a>
			<button id="site-theme-toggle" type="button" aria-label="Toggle light and dark mode">🌙</button>
		</div>
	</nav>
</header>
<script is:inline>
	(() => {
		const storageKey = 'site-theme';
		const root = document.documentElement;
		const toggle = document.getElementById('site-theme-toggle');
		const apply = (theme) => {
			root.setAttribute('data-theme', theme);
			if (toggle) toggle.textContent = theme === 'dark' ? '☀️' : '🌙';
		};
		apply(localStorage.getItem(storageKey) === 'light' ? 'light' : 'dark');
		toggle?.addEventListener('click', () => {
			const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
			localStorage.setItem(storageKey, next);
			apply(next);
		});
	})();
</script>
<style>
	header { margin: 0; padding: 0 1em; background: white; box-shadow: 0 2px 8px rgba(var(--black), 5%); }
	h2 { margin: 0; font-size: 1em; }
	h2 a, h2 a.active { text-decoration: none; }
	nav { display: flex; align-items: center; justify-content: space-between; gap: 1em; }
	nav a, .priced-in-dropdown summary { padding: 1em 0.5em; color: var(--header-text); border-bottom: 4px solid transparent; text-decoration: none; cursor: pointer; list-style: none; }
	nav a.active { text-decoration: none; border-bottom-color: var(--accent); }
	.social-links, .social-links a { display: flex; align-items: center; }
	.social-links { gap: 0.35rem; }
	#site-theme-toggle { border: 1px solid rgb(var(--gray-light)); border-radius: 999px; background: transparent; cursor: pointer; width: 34px; height: 34px; }
	.search-wrapper { flex: 1; max-width: 300px; margin: 0 1em; }
	.priced-in-dropdown { position: relative; }
	.priced-in-dropdown summary { display: inline-flex; align-items: center; }
	.priced-in-dropdown summary::-webkit-details-marker { display: none; }
	.dropdown-menu {
		position: absolute;
		top: calc(100% + 0.2rem);
		left: 0;
		display: grid;
		min-width: 220px;
		background: var(--header-bg);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		box-shadow: var(--box-shadow);
		z-index: 10;
	}
	.dropdown-menu a { padding: 0.6rem 0.75rem; border-bottom: 0; }
	@media (max-width: 720px) {
		.social-links, .search-wrapper { display: none; }
	}
</style>
