---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const postsByTag = posts.reduce((acc, post) => {
	if (post.data.tags) {
		post.data.tags.forEach((tag) => {
			if (tag !== 'Newsletter') {
				if (!acc[tag]) acc[tag] = [];
				acc[tag].push(post);
			}
		});
	}
	return acc;
}, {} as Record<string, typeof posts>);
Object.keys(postsByTag).forEach((tag) => postsByTag[tag].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()));
const sortedTags = Object.keys(postsByTag).sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog Tags" description="Browse blog posts by tag" />
		<style>
			.tag-pill { display: inline-block; padding: 0.22rem 0.65rem; border: 1px solid var(--border); border-radius: 999px; margin: 0 0.35rem 0.35rem 0; }
			.tag-section { margin-top: 2rem; }
			.tag-header { display: flex; gap: 0.6rem; align-items: baseline; border-bottom: 1px solid var(--border); margin-bottom: 0.8rem; }
			.post-count { color: var(--text-muted); font-size: 0.95rem; }
		</style>
	</head>
	<body>
		<Header />
		<main class="tags-shell">
			<h1>Browse by Tag</h1>
			<div>
				{sortedTags.map((tag) => <a href={`#${tag}`} class="tag-pill">{tag} ({postsByTag[tag].length})</a>)}
			</div>
			{
				sortedTags.map((tag) => (
					<section class="tag-section" id={tag}>
						<div class="tag-header"><h2>{tag}</h2><span class="post-count">{postsByTag[tag].length} posts</span></div>
						<ul class="blog-grid">
							{postsByTag[tag].map((post) => (
								<li class="post-card">
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image src={post.data.heroImage} alt={`Cover image for ${post.data.title}`} width={600} height={300} />
										)}
										<h3>{post.data.title}</h3>
										<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
