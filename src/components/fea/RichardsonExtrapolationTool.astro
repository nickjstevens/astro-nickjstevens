		--tool-accent: var(--accent);
		--tool-accent-strong: color-mix(in srgb, var(--accent) 75%, white 25%);
		--tool-surface: color-mix(in srgb, var(--surface-alt) 82%, transparent);
		--tool-surface-strong: color-mix(in srgb, var(--surface-strong) 96%, transparent);
		--tool-border: color-mix(in srgb, var(--border) 85%, transparent);
		--tool-grid-line: color-mix(in srgb, var(--border) 75%, transparent);
		--tool-finite: #38bdf8;
		--tool-exact: #f59e0b;
		--tool-error: #fca5a5;
		--tool-note: #fef3c7;
