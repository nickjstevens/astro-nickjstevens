---
const rawPathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const pathname = rawPathname.length > 1 ? rawPathname.replace(/\/$/, '') : rawPathname;
const isPricedIn = pathname.startsWith('/priced-in');
const isBlog = pathname === '/blog' || pathname.startsWith('/blog/');
const isTags = pathname === '/blog/tags' || pathname.startsWith('/blog/tag/');

const pricedInLinks = [
	{ href: '/priced-in/index.html', label: 'Cost of Living', active: pathname === '/priced-in' || pathname.startsWith('/priced-in/index.html') },
	{ href: '/priced-in/single.html?item=house&denom=context:fiat', label: 'Single Series', active: pathname.startsWith('/priced-in/single') },
	{ href: '/priced-in/macro.html', label: 'Macro Trends', active: pathname.startsWith('/priced-in/macro') },
	{ href: '/priced-in/assumptions.html', label: 'About Priced In', active: pathname.startsWith('/priced-in/assumptions') },
];
---

<header class="site-header">
	<nav>
		<div class="site-header-left">
			<a class="site-logo" href="/">Nick J Stevens</a>
			<div class="site-nav">
				<a href="/" class:list={{ active: pathname === '/' }}>Home</a>
				<a href="/blog" class:list={{ active: isBlog && !isTags }}>Blog</a>
				<a href="/blog/tags" class:list={{ active: isTags }}>Tags</a>
				<details class="site-dropdown">
					<summary class:list={{ active: isPricedIn }}>Priced In</summary>
					<div class="site-dropdown-menu">
						{pricedInLinks.map((link) => (
							<a href={link.href} class:list={{ active: link.active }}>{link.label}</a>
						))}
					</div>
				</details>
				<a href="/about" class:list={{ active: pathname === '/about' }}>About</a>
				<a href="/now" class:list={{ active: pathname === '/now' }}>Now</a>
			</div>
		</div>
		<div class="social-links">
			<a href="https://x.com/nick_j_stevens" target="_blank" rel="noopener noreferrer" aria-label="Follow me on X" data-tooltip="Follow me on X">𝕏</a>
			<a href="https://github.com/nickjstevens" target="_blank" rel="noopener noreferrer" aria-label="Follow me on GitHub" data-tooltip="Follow me on GitHub"><svg class="social-icon-glyph" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5A12 12 0 0 0 8.2 23.9c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.6-1.4-5.6-6.1 0-1.3.5-2.4 1.2-3.3-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.2 11.2 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.3 2.9.1 3.2.8.9 1.2 2 1.2 3.3 0 4.8-2.9 5.8-5.6 6.1.4.4.8 1.1.8 2.2v3.3c0 .4.2.8.8.6A12 12 0 0 0 12 .5Z"/></svg></a>
			<a href="https://primal.net/p/npub1ljq0jgmha3xlv90jyqwcel3f0fvhyzcshk3lugk3qmt8ufcm4e7qs2cpnl" target="_blank" rel="noopener noreferrer" aria-label="Follow me on Nostr" data-tooltip="Follow me on Nostr"><svg class="social-icon-glyph" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9.36 3.18c.4-.55 1.08-.88 1.8-.88h1.68c.72 0 1.4.33 1.8.88l1.2 1.66 2.04.3c.69.1 1.29.56 1.58 1.2l.67 1.48c.3.65.26 1.42-.1 2.04l-1.06 1.8.24 2.08c.08.7-.2 1.38-.74 1.84l-1.28 1.08-.43 2.06c-.14.68-.64 1.25-1.3 1.5l-1.56.58c-.67.25-1.42.13-1.98-.3L12 20.43l-1.66 1.14c-.56.39-1.31.5-1.98.25l-1.56-.58c-.66-.25-1.16-.82-1.3-1.5l-.43-2.06-1.28-1.08a2.13 2.13 0 0 1-.74-1.84l.24-2.08-1.06-1.8a2.13 2.13 0 0 1-.1-2.04l.67-1.49c.29-.63.89-1.08 1.58-1.18l2.04-.31 1.2-1.66Zm1.9 3.06-2.76 7.52h1.61l.55-1.6h2.69l.56 1.6h1.6L12.76 6.24h-1.5Zm1.63 4.58H11.1l.9-2.57.9 2.57Z"/></svg></a>
			<button id="site-theme-toggle" type="button" aria-label="Toggle light and dark mode" data-tooltip="Toggle light/dark mode">🌙</button>
		</div>
	</nav>
</header>
<script is:inline>
	(() => {
		const storageKey = 'site-theme';
		const root = document.documentElement;
		const toggle = document.getElementById('site-theme-toggle');
		const apply = (theme) => {
			root.setAttribute('data-theme', theme);
			if (toggle) toggle.textContent = theme === 'dark' ? '☀️' : '🌙';
		};
		apply(localStorage.getItem(storageKey) === 'light' ? 'light' : 'dark');
		toggle?.addEventListener('click', () => {
			const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
			localStorage.setItem(storageKey, next);
			apply(next);
		});
	})();
</script>
<style>
	.site-header {
		margin: 0;
		padding: 0 1rem;
		background: var(--surface-strong);
		border-bottom: 1px solid var(--border);
	}
	nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 74px; }
	.site-header-left { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
	.site-logo { font-weight: 700; text-decoration: none; color: var(--text); }
	.site-nav { display: flex; align-items: center; gap: 0.25rem; flex-wrap: wrap; }
	.site-nav a, .site-dropdown summary {
		padding: 0.65rem 0.55rem;
		color: var(--text);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		list-style: none;
		display: inline-flex;
		align-items: center;
	}
	.site-nav a.active, .site-dropdown summary.active, .site-dropdown-menu a.active { border-bottom-color: var(--accent); }
	.site-dropdown { position: relative; }
	.site-dropdown summary::-webkit-details-marker { display: none; }
	.site-dropdown[open] .site-dropdown-menu,
	.site-dropdown:hover .site-dropdown-menu,
	.site-dropdown:focus-within .site-dropdown-menu { display: grid; }
	.site-dropdown:not([open]):not(:hover):not(:focus-within) .site-dropdown-menu { display: none; }
	.site-dropdown-menu {
		position: absolute;
		top: calc(100% + 0.2rem);
		left: 0;
		display: grid;
		min-width: 240px;
		background: var(--surface-strong);
		border: 1px solid var(--border);
		border-radius: 12px;
		box-shadow: var(--shadow);
		z-index: 20;
	}
	.site-dropdown-menu a { border-bottom: 0; }
	.social-links { display: flex; align-items: center; gap: 0.45rem; }
	.social-links a, #site-theme-toggle {
		display: inline-flex; align-items: center; justify-content: center;
		width: 36px; height: 36px; border-radius: 999px;
		border: 1px solid var(--input-border); background: var(--surface-alt);
		color: var(--text); text-decoration: none; font-size: 0.8rem; font-weight: 700;
		position: relative;
	}
	.social-icon-glyph { width: 16px; height: 16px; }
	.social-links a::after,
	#site-theme-toggle::after {
		content: attr(data-tooltip);
		position: absolute;
		left: 50%;
		bottom: calc(100% + 0.5rem);
		transform: translate(-50%, 0.2rem);
		opacity: 0;
		pointer-events: none;
		white-space: nowrap;
		background: var(--surface-strong);
		color: var(--text);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 0.2rem 0.45rem;
		font-size: 0.7rem;
		line-height: 1.2;
		transition: opacity 0.15s ease, transform 0.15s ease;
	}
	.social-links a:hover::after,
	.social-links a:focus-visible::after,
	#site-theme-toggle:hover::after,
	#site-theme-toggle:focus-visible::after {
		opacity: 1;
		transform: translate(-50%, 0);
	}
	.social-links > :first-child::after { left: 0; transform: translate(0, 0.2rem); }
	.social-links > :first-child:hover::after,
	.social-links > :first-child:focus-visible::after { transform: translate(0, 0); }
	.social-links > :nth-last-child(-n+2)::after { left: auto; right: 0; transform: translate(0, 0.2rem); }
	.social-links > :nth-last-child(-n+2):hover::after,
	.social-links > :nth-last-child(-n+2):focus-visible::after { transform: translate(0, 0); }
	#site-theme-toggle { cursor: pointer; }
	@media (max-width: 900px) {
		.site-nav { font-size: 0.95rem; }
	}
</style>
