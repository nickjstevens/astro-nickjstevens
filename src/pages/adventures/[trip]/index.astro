---
import { getCollection, render } from 'astro:content';
import AdventureLayout from '../../../layouts/AdventureLayout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('adventures');
	return entries
		.filter((entry) => entry.data.kind === 'trip')
		.map((entry) => ({ params: { trip: entry.data.tripSlug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allEntries = await getCollection('adventures');
const days = allEntries
	.filter((item) => item.data.kind === 'day' && item.data.tripSlug === entry.data.tripSlug)
	.sort((a, b) => a.data.order - b.data.order);
---

<AdventureLayout title={entry.data.title} description={entry.data.description} heroImage={entry.data.heroImage}>
	<Content />
	<section class="day-list" aria-labelledby="days-heading">
		<h2 id="days-heading">Day by day</h2>
		<ol>
			{days.map((day) => (
				<li>
					<a href={`/adventures/${day.data.tripSlug}/${day.id.split('/').pop()}/`}>
						<span>Day {day.data.order}</span>
						<strong>{day.data.title.replace(/^Day\s+\d+\s*-\s*/i, '')}</strong>
						{day.data.sleepLocation && <em>{day.data.sleepLocation}</em>}
					</a>
				</li>
			))}
		</ol>
	</section>
</AdventureLayout>

<style>
	.day-list { margin-top: 2.5rem; }
	.day-list ol { list-style: none; display: grid; gap: 0.75rem; padding: 0; margin: 1rem 0 0; }
	.day-list li { margin: 0; }
	.day-list a { display: grid; grid-template-columns: auto 1fr auto; gap: 0.8rem; align-items: center; padding: 0.9rem 1rem; border: 1px solid var(--border); border-radius: 14px; background: var(--surface-alt); color: inherit; text-decoration: none; }
	.day-list a:hover { border-color: var(--accent); color: inherit; text-decoration: none; }
	.day-list span, .day-list em { color: var(--text-muted); font-style: normal; font-size: 0.95rem; }
	@media (max-width: 720px) { .day-list a { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
