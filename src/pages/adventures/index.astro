---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';

const entries = await getCollection('adventures');
const trips = entries
	.filter((entry) => entry.data.kind === 'trip')
	.sort((a, b) => b.data.year - a.data.year || b.data.title.localeCompare(a.data.title));
const daysByTrip = new Map<string, number>();
for (const entry of entries) {
	if (entry.data.kind !== 'day') continue;
	daysByTrip.set(entry.data.tripSlug, (daysByTrip.get(entry.data.tripSlug) ?? 0) + 1);
}
---

<html lang="en">
	<head>
		<BaseHead title="Adventures" description="Family adventure journals, itineraries, photos, and travel notes." />
	</head>
	<body>
		<Header />
		<main class="adventures-shell">
			<section class="adventures-index">
				<p class="eyebrow">Family travel journals</p>
				<h1>Adventures</h1>
				<p class="intro">A home for our family travel logs: trip overviews, day-by-day notes, route ideas, and favourite photos.</p>
				<div class="adventure-grid">
					{trips.map((trip) => (
						<a class="adventure-card" href={`/adventures/${trip.data.tripSlug}/`}>
							{trip.data.heroImage && <Image src={trip.data.heroImage} alt="" width={600} height={337} loading="lazy" />}
							<div>
								<p class="card-kicker">{trip.data.icon} {trip.data.year} · {daysByTrip.get(trip.data.tripSlug) ?? 0} days</p>
								<h2>{trip.data.title}</h2>
								<p>{trip.data.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) { background-size: 100% 920px; }
	.adventures-shell { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: clamp(2rem, 5vw, 4rem) 0; }
	.adventures-index { min-height: 60vh; }
	.adventures-index h1 { font-size: clamp(3.5rem, 9vw, 7rem); margin-bottom: 0.5rem; }
	.eyebrow, .card-kicker { color: var(--text-muted); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
	.intro { max-width: 760px; color: var(--text-muted); font-size: 1.25rem; }
	.adventure-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; margin-top: 2rem; }
	.adventure-card { display: grid; gap: 1rem; overflow: hidden; border: 1px solid var(--border); border-radius: 18px; background: var(--surface-strong); color: inherit; text-decoration: none; box-shadow: var(--box-shadow); }
	.adventure-card:hover { color: inherit; text-decoration: none; transform: translateY(-2px); }
	.adventure-card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0; }
	.adventure-card div { padding: 1rem; }
	.adventure-card img + div { padding-top: 0; }
	.adventure-card h2 { margin-bottom: 0.35rem; }
	.adventure-card p { margin: 0; }
</style>
