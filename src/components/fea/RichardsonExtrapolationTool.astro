</style>

<script>
	import { axisBottom, axisLeft, line, scaleLinear, select } from 'd3';
	import { calculateRichardsonExtrapolation } from '../../lib/richardson-extrapolation.js';

	const SAMPLE_INPUTS = {
		meshSize1: 2,
		meshSize2: 1,
		meshSize3: 0.5,
		resultValue1: 200,
		resultValue2: 210,
		resultValue3: 215,
	};

	const valueFormat = new Intl.NumberFormat('en-GB', {
		minimumFractionDigits: 5,
		maximumFractionDigits: 5,
	});

	const compactFormat = new Intl.NumberFormat('en-GB', {
		minimumFractionDigits: 0,
		maximumFractionDigits: 3,
	});

	const percentFormat = new Intl.NumberFormat('en-GB', {
		style: 'percent',
		minimumFractionDigits: 2,
		maximumFractionDigits: 2,
	});

	function formatDecimal(value, digits = 3) {
		return Number.isFinite(value) ? value.toFixed(digits) : '--';
	}

	function formatValue(value) {
		return Number.isFinite(value) ? valueFormat.format(value) : '--';
	}

	function formatPercent(value) {
		return Number.isFinite(value) ? percentFormat.format(value) : '--';
	}

	function formatAxisValue(value) {
		if (Math.abs(value) >= 1000) {
			return compactFormat.format(Math.round(value));
		}

		if (Math.abs(value) >= 1) {
			return compactFormat.format(value);
		}

		return value.toFixed(2);
	}

	function numericPadding(minimum, maximum) {
		const span = Math.abs(maximum - minimum) || Math.max(Math.abs(maximum), 1);
		return span * 0.14;
	}

	function initialiseTool(root) {
		const form = root.querySelector('[data-form]');
		const status = root.querySelector('[data-status]');
		const warningList = root.querySelector('[data-warnings]');
		const chart = root.querySelector('[data-chart]');
		const chartEmpty = root.querySelector('[data-chart-empty]');
		const chartCaption = root.querySelector('[data-chart-caption]');
		const fields = Object.fromEntries(
			Array.from(root.querySelectorAll('[data-field]')).map((node) => [node.dataset.field, node]),
		);
		const inputs = Object.fromEntries(
			Array.from(root.querySelectorAll('input[data-key]')).map((node) => [node.dataset.key, node]),
		);
		const sampleButton = root.querySelector('[data-action="sample"]');

		let lastState = null;

		function setStatus(message, isError = false) {
			status.textContent = message;
			status.classList.toggle('is-error', isError);
		}

		function resetOutputs() {
			Object.values(fields).forEach((field) => {
				field.textContent = '--';
			});
			warningList.innerHTML = '<li>No warnings yet.</li>';
			chartEmpty.classList.remove('is-hidden');
			chartCaption.textContent = 'Confidence bounds are shown around the extrapolated exact value.';
			select(chart).selectAll('*').remove();
			lastState = null;
		}

		function loadSampleInputs() {
			Object.entries(SAMPLE_INPUTS).forEach(([key, value]) => {
				inputs[key].value = String(value);
			});
		}

		function readInputs() {
			const rawValues = Object.fromEntries(
				Object.entries(inputs).map(([key, input]) => [key, Number(input.value)]),
			);

			return {
				meshSizes: [rawValues.meshSize1, rawValues.meshSize2, rawValues.meshSize3],
				resultValues: [rawValues.resultValue1, rawValues.resultValue2, rawValues.resultValue3],
			};
		}

		function renderWarnings(warnings) {
			if (!warnings.length) {
				warningList.innerHTML = '<li>No warnings. The refinement ratios and convergence check are within the usual screening thresholds.</li>';
				return;
			}

			warningList.innerHTML = warnings.map((warning) => `<li>${warning}</li>`).join('');
		}

		function renderChart(state) {
			const rect = chart.getBoundingClientRect();
			const width = Math.max(Math.round(rect.width), 320);
			const height = 360;
			const margin = { top: 28, right: 24, bottom: 58, left: 72 };
			const innerWidth = width - margin.left - margin.right;
			const innerHeight = height - margin.top - margin.bottom;
			const meshPoints = state.inputs.meshSizes.map((meshSize, index) => ({
				meshSize,
				value: state.inputs.resultValues[index],
				label: ['Coarsest', 'Medium', 'Finest'][index],
				kind: 'mesh',
			}));
			const exactPoint = {
				meshSize: 0,
				value: state.results.extrapolatedValue,
				label: 'Continuum',
				kind: 'exact',
			};
			const plottedPoints = [exactPoint, ...meshPoints].sort((left, right) => left.meshSize - right.meshSize);
			const allYValues = [
				...state.inputs.resultValues,
				state.results.extrapolatedValue,
				state.results.lowerBound,
				state.results.upperBound,
			];
			const maximumMeshSize = Math.max(...state.inputs.meshSizes);
			const xScale = scaleLinear()
				.domain([maximumMeshSize * -0.12, maximumMeshSize * 1.08])
				.range([margin.left, width - margin.right]);
			const yMinimum = Math.min(...allYValues);
			const yMaximum = Math.max(...allYValues);
			const yPadding = numericPadding(yMinimum, yMaximum);
			const yScale = scaleLinear()
				.domain([yMinimum - yPadding, yMaximum + yPadding])
				.range([height - margin.bottom, margin.top]);
			const styles = getComputedStyle(root);
			const axisColor = styles.getPropertyValue('--text-muted').trim() || '#94a3b8';
			const gridColor = styles.getPropertyValue('--tool-grid-line').trim() || 'rgba(148, 163, 184, 0.25)';
			const finiteColor = styles.getPropertyValue('--tool-finite').trim() || '#38bdf8';
			const exactColor = styles.getPropertyValue('--tool-exact').trim() || '#f59e0b';
			const cardBackground = styles.getPropertyValue('--tool-surface-strong').trim() || 'rgba(15, 23, 42, 0.96)';
			const lineGenerator = line()
				.x((point) => xScale(point.meshSize))
				.y((point) => yScale(point.value));
			const svg = select(chart);

			svg.attr('viewBox', `0 0 ${width} ${height}`);
			svg.selectAll('*').remove();

			const horizontalGridTicks = yScale.ticks(5);

			svg
				.append('g')
				.attr('aria-hidden', 'true')
				.selectAll('line')
				.data(horizontalGridTicks)
				.enter()
				.append('line')
				.attr('x1', margin.left)
				.attr('x2', width - margin.right)
				.attr('y1', (tick) => yScale(tick))
				.attr('y2', (tick) => yScale(tick))
				.attr('stroke', gridColor)
				.attr('stroke-width', 1);

			svg
				.append('path')
				.datum(plottedPoints)
				.attr('fill', 'none')
				.attr('stroke', finiteColor)
				.attr('stroke-width', 2.5)
				.attr('stroke-dasharray', '8 6')
				.attr('d', lineGenerator);

			const errorBarGroup = svg.append('g').attr('aria-hidden', 'true');
			const exactX = xScale(exactPoint.meshSize);
			const capWidth = Math.max(innerWidth * 0.03, 10);

			errorBarGroup
				.append('line')
				.attr('x1', exactX)
				.attr('x2', exactX)
				.attr('y1', yScale(state.results.lowerBound))
				.attr('y2', yScale(state.results.upperBound))
				.attr('stroke', exactColor)
				.attr('stroke-width', 3);

			errorBarGroup
				.selectAll('line.cap')
				.data([state.results.lowerBound, state.results.upperBound])
				.enter()
				.append('line')
				.attr('class', 'cap')
				.attr('x1', exactX - capWidth)
				.attr('x2', exactX + capWidth)
				.attr('y1', (value) => yScale(value))
				.attr('y2', (value) => yScale(value))
				.attr('stroke', exactColor)
				.attr('stroke-width', 3);

			const pointGroup = svg.append('g');
			const points = pointGroup
				.selectAll('g.point')
				.data(plottedPoints)
				.enter()
				.append('g')
				.attr('class', 'point');

			points
				.append('circle')
				.attr('cx', (point) => xScale(point.meshSize))
				.attr('cy', (point) => yScale(point.value))
				.attr('r', (point) => (point.kind === 'exact' ? 7 : 6))
				.attr('fill', (point) => (point.kind === 'exact' ? exactColor : finiteColor))
				.attr('stroke', cardBackground)
				.attr('stroke-width', 2);

			points
				.append('text')
				.attr('x', (point) => xScale(point.meshSize))
				.attr('y', (point) => yScale(point.value) - 12)
				.attr('text-anchor', 'middle')
				.attr('fill', axisColor)
				.attr('font-size', 12)
				.attr('font-weight', 700)
				.text((point) => point.label);

			svg
				.append('g')
				.attr('transform', `translate(0, ${height - margin.bottom})`)
				.call(axisBottom(xScale).ticks(6).tickFormat((tick) => formatAxisValue(tick)))
				.call((group) => group.selectAll('path, line').attr('stroke', axisColor))
				.call((group) => group.selectAll('text').attr('fill', axisColor));

			svg
				.append('g')
				.attr('transform', `translate(${margin.left}, 0)`)
				.call(axisLeft(yScale).ticks(5).tickFormat((tick) => formatAxisValue(tick)))
				.call((group) => group.selectAll('path, line').attr('stroke', axisColor))
				.call((group) => group.selectAll('text').attr('fill', axisColor));

			svg
				.append('text')
				.attr('x', margin.left + innerWidth / 2)
				.attr('y', height - 14)
				.attr('fill', axisColor)
				.attr('font-size', 13)
				.attr('text-anchor', 'middle')
				.text('Element edge length');

			svg
				.append('text')
				.attr('transform', `translate(18, ${margin.top + innerHeight / 2}) rotate(-90)`)
				.attr('fill', axisColor)
				.attr('font-size', 13)
				.attr('text-anchor', 'middle')
				.text('Result value');

			const legend = svg.append('g').attr('transform', `translate(${width - margin.right - 180}, ${margin.top - 4})`);
			const legendRows = [
				{ label: 'Mesh results', color: finiteColor },
				{ label: 'Exact estimate + 95% CI', color: exactColor },
			];

			const legendItems = legend
				.selectAll('g')
				.data(legendRows)
				.enter()
				.append('g')
				.attr('transform', (_, index) => `translate(0, ${index * 22})`);

			legendItems
				.append('line')
				.attr('x1', 0)
				.attr('x2', 18)
				.attr('y1', 8)
				.attr('y2', 8)
				.attr('stroke', (item) => item.color)
				.attr('stroke-width', 3);

			legendItems
				.append('text')
				.attr('x', 24)
				.attr('y', 12)
				.attr('fill', axisColor)
				.attr('font-size', 12)
				.text((item) => item.label);

			chartEmpty.classList.add('is-hidden');
			chartCaption.textContent = `Exact estimate ${formatValue(state.results.extrapolatedValue)} with a 95% interval from ${formatValue(state.results.lowerBound)} to ${formatValue(state.results.upperBound)}.`;
		}

		function renderResults(payload) {
			fields.extrapolatedValue.textContent = formatValue(payload.extrapolatedValue);
			fields.lowerBound.textContent = formatValue(payload.lowerBound);
			fields.upperBound.textContent = formatValue(payload.upperBound);
			fields.orderOfConvergence.textContent = formatDecimal(payload.orderOfConvergence, 3);
			fields.convergenceCheck.textContent = formatDecimal(payload.convergenceCheck, 3);
			fields.gci23.textContent = formatPercent(payload.gridConvergenceIndex.gci23);
			fields.ratios.textContent = `${formatDecimal(payload.refinementRatios.r12, 3)} / ${formatDecimal(payload.refinementRatios.r23, 3)}`;
			fields.iterations.textContent = String(payload.iterations);
			renderWarnings(payload.warnings);
		}

		function runCalculation() {
			try {
				const payload = readInputs();
				const results = calculateRichardsonExtrapolation(payload);

				renderResults(results);
				setStatus('Calculation complete. Review the convergence checks before using the extrapolated value.');
				lastState = { inputs: payload, results };
				renderChart(lastState);
			} catch (error) {
				resetOutputs();
				const message = error instanceof Error ? error.message : 'The calculation failed.';
				setStatus(message, true);
			}
		}

		const resizeObserver = new ResizeObserver(() => {
			if (lastState) {
				renderChart(lastState);
			}
		});

		resizeObserver.observe(chart);

		const themeObserver = new MutationObserver(() => {
			if (lastState) {
				renderChart(lastState);
			}
		});

		themeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			runCalculation();
		});

		sampleButton?.addEventListener('click', () => {
			loadSampleInputs();
			runCalculation();
		});

		Object.values(inputs).forEach((input) => {
			input.addEventListener('change', () => {
				if (lastState) {
					runCalculation();
				}
			});
		});

		loadSampleInputs();
		runCalculation();
	}

	document.querySelectorAll('[data-richardson-tool]').forEach((root) => {
		if (root instanceof HTMLElement) {
			initialiseTool(root);
		}
	});
</script>
